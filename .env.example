# Copy to .env and fill in your own values. Never commit the real .env file.

# Note: this is a client-side Vite app with no backend yet, so this key
# ships inside the browser bundle and is visible to anyone who opens
# devtools. Fine for local prototyping; route through a backend before
# shipping this to real users.
VITE_GEMINI_API_KEY=

# OAuth Client ID from Google Cloud Console (Credentials > OAuth client ID,
# type "Web application"). Unlike the Gemini key above, this one is meant
# to be public — it's not a secret, just an identifier.
# Prerequisites in Google Cloud Console for this to work:
#   1. Enable the "Google Calendar API" under APIs & Services > Library.
#   2. Add http://localhost:5173 (and any other dev origin you use) under
#      "Authorized JavaScript origins" on the OAuth client.
#   3. Configure the OAuth consent screen (test users if it's still in
#      "Testing" publishing status). "openid", "email", and "profile" are
#      non-sensitive scopes available by default; "calendar.readonly" is a
#      sensitive scope you'll need to add explicitly under Data Access.
VITE_GOOGLE_CLIENT_ID=

# Firebase project config — GoogleSignIn.tsx signs in via Firebase Auth's
# Google provider (still the same GCP project as VITE_GOOGLE_CLIENT_ID
# above; a Firebase project IS a GCP project), and Firestore stores
# per-user data like the character and daily check-ins.
# Get these from Firebase Console > Project settings (gear icon) > General
# > Your apps > (add a Web app if none exists yet).
# Prerequisites in Firebase Console:
#   1. Build > Authentication > Sign-in method > enable Google.
#   2. Build > Firestore Database > create one (production mode) if it
#      doesn't already exist.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Plain API key from Google Cloud Console (Credentials > Create Credentials
# > API key), restricted specifically to "Places API (New)". Used for the
# Nearby Search call in googlePlaces.ts (recovery-nudge feature). Ships in
# the browser bundle like the other keys above — restrict it by HTTP
# referrer too (e.g. http://localhost:5173/*).
# Prerequisites in Google Cloud Console:
#   1. Enable "Places API (New)" under APIs & Services > Library — this is
#      a separate product from the legacy "Places API".
#   2. Places API billing works like the rest of Google Cloud (a monthly
#      free credit, but a Cloud Billing account must be linked) — it does
#      NOT have an AI-Studio-style always-free tier the way Gemini does.
VITE_GOOGLE_PLACES_API_KEY=

# A SEPARATE key from the Places one above — restricted specifically to
# "Maps Embed API", used only for the map preview iframe in
# RecoverySuggestionCard.tsx. Do not reuse the Places key here and don't
# swap these two: API restrictions are per-key, so a key locked to Places
# API (New) gets rejected by the embed iframe with "This API key is not
# authorized to use this service," even though both keys can belong to the
# same Cloud project.
# Prerequisite: enable "Maps Embed API" under APIs & Services > Library.
# Unlike Places API, this one is genuinely free with no billing account
# required (confirmed against Google's docs) — just needs the separate
# enablement step.
VITE_GOOGLE_MAPS_API_KEY=
